# Local SQLite database file (used by both Prisma CLI and the runtime driver adapter).
DATABASE_URL="file:./prisma/dev.db"

# Used only by the AI communication layer (lib/ai/alex.ts) to phrase Alex's
# briefs, recaps, and insights. All workout math is deterministic and does not
# require this key. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-key-here

# Only needed for deployed environments (e.g. Vercel) — when set, src/lib/prisma.ts
# and prisma/seed.ts connect to this Turso database instead of the local dev.db
# file, since deployed serverless functions have no persistent local disk.
# Get these from `turso db show <db-name>` and `turso db tokens create <db-name>`.
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
