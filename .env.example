# Local SQLite database file (used by both Prisma CLI and the runtime driver adapter).
DATABASE_URL="file:./prisma/dev.db"

# Used only by the AI communication layer (lib/ai/alex.ts) to phrase Alex's
# briefs, recaps, and insights. All workout math is deterministic and does not
# require this key. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-key-here
